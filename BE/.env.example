NODE_ENV=development
PORT=4000
# Use resend to send email; development-file is local-only and sends nothing.
PASSWORD_RESET_DELIVERY=development-file
RESEND_API_KEY=re_replace_with_your_api_key
# Plain address on a domain verified in your Resend account (no display name).
PASSWORD_RESET_FROM=password-reset@example.com
FRONTEND_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Required: generate 32 random bytes as 64 hex characters; never reuse a sample key.
ACCESS_TOKEN_SECRET=
# Fake local placeholders only. Replace before using database functionality.
DATABASE_URL=postgresql://example_user:fake_password@localhost:5432/swasthyasetu_example
